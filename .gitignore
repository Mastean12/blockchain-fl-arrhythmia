.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

data/raw/mitbih/
data/processed/mitbih_v1/
data/splits/mitbih_v1/*/*.npz

# Day 11 robustness runs: per-run checkpoints and prediction arrays are regenerable
# (src.federated.robustness.run_all); summary tables, figures and per-run CSV/JSON stay tracked.
results/robustness/models/
results/robustness/metrics/federated/*.npz

# Day 12 diagnostics: per-run checkpoints and prediction arrays are regenerable
# (src.federated.robustness.run_all with the diagnostic config).
results/diagnostics/*/models/
results/diagnostics/*/metrics/federated/*.npz

# Day 13 privacy runs: per-run checkpoints and prediction arrays are regenerable
# (src.federated.robustness.run_all with configs/privacy/dp_fedavg_v1.json).
results/privacy/models/
results/privacy/metrics/federated/*.npz

# Day 14 HE runs: per-run checkpoints and prediction arrays are regenerable
# (src.federated.robustness.run_all with configs/he/he_fedavg_v1.json).
results/he/models/
results/he/metrics/federated/*.npz

# Day 16 blockchain integration: off-chain model archive, checkpoints and prediction arrays are regenerable
# (src.federated.robustness.run_all with configs/blockchain/fedavg_blockchain_v1.json). Ledgers and anchors stay tracked.
results/blockchain_integration/offchain/
results/blockchain_integration/models/
results/blockchain_integration/metrics/federated/*.npz

# Day 17 malicious-client runs: per-run checkpoints, prediction arrays and global trajectories are regenerable
# (src.federated.security.run_all with configs/security/attacks_v1.json).
results/security/models/
results/security/metrics/federated/*.npz
