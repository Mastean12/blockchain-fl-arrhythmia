{
  "experiment_id": "fedavg_blockchain_lifecycle_v2",
  "random_seed": 42,
  "model": {"architecture": "centralized_cnn_v1", "class": "src.models.cnn1d.ECG1DCNN", "dropout": 0.3},
  "data": {"split_root": "data/splits/mitbih_v1", "label_config": "configs/preprocessing/mitbih_v1.json"},
  "partition": {"strategy": "random_group_equal_count", "num_clients": 5, "seed": 42, "min_client_segments": 1000},
  "training": {"rounds": 20, "local_epochs": 1, "batch_size": 256, "learning_rate": 0.001,
    "optimizer": "Adam", "loss": "CrossEntropyLoss", "shuffle_training": true, "client_optimizer_state": "reset_each_round"},
  "participation": {"fraction": 1.0},
  "aggregation": {"method": "FedAvg", "weighting": "client_training_samples", "batchnorm": "aggregate"},
  "model_selection": {"split": "validation", "metric": "validation_loss", "mode": "min"},
  "runtime": {"device": "cpu", "cpu_threads": 8, "num_workers": 0, "evaluation_batch_size": 512},
  "blockchain": {
    "enabled": true,
    "mode": "lifecycle_gate_v2",
    "ledger_id": "fedavg_lifecycle_gate_v2",
    "commit_policy": "commit sorted participant IDs, sample counts, and SHA-256 update hashes before aggregation; reject altered, missing, duplicate, stale, or invalid submissions; append aggregate model hash before broadcast",
    "external_anchor": true
  },
  "output_root": "results/blockchain_lifecycle_v2"
}
